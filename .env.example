# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ======================
# Flask Configuration
# ======================
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=8000

# ======================
# API Configuration
# ======================

# Directory for temporary files (use /tmp on Render)
DATA_DIR=/tmp

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://pedestrian-frontend-web.onrender.com

# ======================
# Vultr Object Storage (S3-compatible)
# ======================

# Enable/disable S3 storage (true/false)
USE_S3_STORAGE=false

# S3 credentials (Vultr Object Storage)
# Get these from: Vultr Console → Object Storage → S3 Credentials
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here

# S3 endpoint URL (Amsterdam region)
S3_ENDPOINT=https://ams1.vultrobjects.com

# S3 bucket name
S3_BUCKET=pedestrian-data-prod

# AWS-compatible region name
S3_REGION=us-east-1

# ======================
# Model Configuration
# ======================

# Path to local model file (fallback if Vultr disabled)
MODEL_PATH=api/models/cb_loco_train_dublin_melbourne_nyc_test_zurich.cbm

# ======================
# Development vs Production
# ======================

# For local development:
# USE_S3_STORAGE=false (use local models)
# FLASK_ENV=development
# FLASK_HOST=127.0.0.1

# For Render deployment:
# USE_S3_STORAGE=true (use Vultr S3)
# FLASK_ENV=production
# FLASK_HOST=0.0.0.0
# (Set S3_ACCESS_KEY and S3_SECRET_KEY via Render Dashboard only, never commit!)
